<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#dddddd">
    <item android:id="@android:id/mask">
        <color android:color="#000000"/>
    </item>
    <item>
        <selector android:exitFadeDuration="@android:integer/config_shortAnimTime">
            <item android:state_selected="true">
                <color android:color="@color/bg_series_select"/>
            </item>
            <item android:state_checked="true">
                <color android:color="@color/bg_series_select"/>
            </item>
            <item android:state_pressed="true">
                <color android:color="@color/bg_series_select"/>
            </item>
            <item>
                <color android:color="@android:color/transparent"/>
            </item>
        </selector>
    </item>
</ripple>
