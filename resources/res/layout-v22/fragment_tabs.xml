<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tabsParent"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <WebView
        android:id="@+id/blockAds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llBanner"
        android:background="@drawable/bg_gradient"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="5dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="74dp"
            android:layout_height="78dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4"
            app:srcCompat="@mipmap/chibi_tabs"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/text"
                android:id="@+id/tvBannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textColor="@color/textSelectSeries"
                    android:id="@+id/btnBanner"
                    android:background="@color/blue_4d"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_weight="1"/>
                <Button
                    android:textColor="@color/textSelectSeries"
                    android:id="@+id/btnHideBanner"
                    android:background="@color/common_google_signin_btn_text_dark_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="Закрыть"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/containerRasp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_rasp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/textItem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Выходит сегодня"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tint_all_rasp"
                    android:id="@+id/btnRasp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Все расписание"
                    android:layout_marginEnd="10dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRasp"
                android:paddingTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="122dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="#ffffff"
        app:tabTextColor="#ffffff"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/tabs"/>
</LinearLayout>
