<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">#616263</item>
        <item name="android:actionBarStyle">@style/MyPopupMenu</item>
        <item name="android:popupMenuStyle">@style/MyPopupMenu</item>
        <item name="android:actionMenuTextColor">#616263</item>
        <item name="android:popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    </style>
    <style name="AppThemeDialog" parent="@style/Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">#616263</item>
        <item name="android:actionBarStyle">@style/MyPopupMenu</item>
        <item name="android:popupMenuStyle">@style/MyPopupMenu</item>
        <item name="android:actionMenuTextColor">#616263</item>
        <item name="android:popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="colorAccent">#616263</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    </style>
    <style name="AutoCompleteTextViewStyle" parent="@style/Widget.AppCompat.Light.AutoCompleteTextView">
        <item name="android:popupBackground">@drawable/search_suggestions_bg</item>
        <item name="android:popupElevation">0dp</item>
    </style>
    <style name="Color1SwitchStyle" parent="">
        <item name="android:colorForeground">@color/blue</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="colorSwitchThumbNormal">@color/text</item>
    </style>
    <style name="ToolbarStyle" parent="">
        <item name="android:contentInsetStart">14dp</item>
        <item name="android:contentInsetLeft">14dp</item>
        <item name="contentInsetLeft">14dp</item>
        <item name="contentInsetStart">14dp</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>
</resources>
