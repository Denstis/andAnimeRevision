<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/vsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <animebestapp.com.menu.SlideMenuView
        android:layout_gravity="start"
        android:id="@+id/navMenu"
        android:background="@color/backgroundNavigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:headerLayout="@layout/header_not_auth"
        app:itemBackground="@drawable/ripple_navigation_selector"
        app:itemIconTint="#7b8494"
        app:itemTextColor="@color/navItemText"/>
</androidx.drawerlayout.widget.DrawerLayout>
