<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bgInfoItemListAnime"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <TextView
        android:textColor="@color/textSelectSeries"
        android:gravity="center"
        android:id="@+id/text"
        android:background="@color/default_select"
        android:layout_width="386dp"
        android:layout_height="31dp"
        android:text="Об приложении"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="325dp"
        android:layout_height="290dp"
        android:layout_marginTop="44dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4"
        app:srcCompat="@mipmap/image_present_one"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_description_anime"
        android:gravity="center"
        android:id="@+id/info"
        android:background="@color/common_google_signin_btn_text_dark_disabled"
        android:layout_width="383dp"
        android:layout_height="78dp"
        android:layout_marginTop="284dp"
        android:text="AnimeBest - Это удобное приложение для просмотра аниме новинок и более 5000 аниме тайтлов онлайн."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/text_description_anime"
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="База аниме принадлежит Anime-Best"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:textColor="@color/textSelectSeries"
        android:id="@+id/btnVK"
        android:background="@color/default_select"
        android:layout_width="109dp"
        android:layout_height="41dp"
        android:layout_marginTop="10dp"
        android:text="Группа ВК"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.19"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1"/>
    <Button
        android:textColor="@color/textSelectSeries"
        android:id="@+id/btnSite"
        android:background="@color/default_select"
        android:layout_width="158dp"
        android:layout_height="41dp"
        android:layout_marginTop="10dp"
        android:text="Сайт приложения"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
