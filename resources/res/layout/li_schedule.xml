<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardBackgroundColor="@color/backgroundItem">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivPreview"
            android:background="@color/colorPrimaryDark"
            android:layout_width="70dp"
            android:layout_height="110dp"
            android:contentDescription="TODO"/>
        <TextView
            android:textColor="@color/textItem"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Легенда о героях Галактики (2018) / Ginga Eiyuu Densetsu: Die Neue These - Kaikou [1-7 из 12+]"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/blue"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            app:layout_constraintBottom_toTopOf="@+id/tvDate"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"/>
        <TextView
            android:textColor="@color/textItem"
            android:gravity="center"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/test_date2"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivPreview"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tvRate"
            android:background="@color/blue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="3.4"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivPreview"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
