<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bgInfoItemListAnime"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <TextView
        android:textColor="@color/textSelectSeries"
        android:gravity="center"
        android:id="@+id/text"
        android:background="@color/common_google_signin_btn_text_dark_disabled"
        android:layout_width="362dp"
        android:layout_height="39dp"
        android:layout_marginTop="4dp"
        android:text="Для добавления закладок необходимо"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.489"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="325dp"
        android:layout_height="290dp"
        android:layout_marginTop="56dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4"
        app:srcCompat="@mipmap/chibi_reg"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/text_description_anime"
        android:gravity="center"
        android:id="@+id/info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="AnimeBest - Это удобное приложение для просмотра аниме новинок и более 3000 аниме тайтлов онлайн."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"/>
    <Button
        android:textColor="@color/textSelectSeries"
        android:id="@+id/btnAuth"
        android:background="@color/default_select"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginTop="316dp"
        android:text="Войти в аккаунт"
        app:layout_constraintEnd_toStartOf="@+id/btnReg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
    <Button
        android:textColor="@color/textSelectSeries"
        android:id="@+id/btnReg"
        android:background="@color/common_google_signin_btn_text_dark_disabled"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:text="создать аккаунт"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnAuth"
        app:layout_constraintTop_toTopOf="@+id/btnAuth"/>
</androidx.constraintlayout.widget.ConstraintLayout>
