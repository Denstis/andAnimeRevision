<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/appbar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/colorPrimary"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:elevation="0dp"
            app:popupTheme="@style/MyPopupMenu"
            style="@style/ToolbarStyle">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Комментарии | Запрещается мат, оскорбление. За нарушение будет наказание!"
                android:maxLines="2"
                android:lines="2"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <TextView
        android:textColor="@color/textItem"
        android:gravity="center"
        android:id="@+id/tvEmpty"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/empty_comments"
        app:layout_constraintTop_toBottomOf="@+id/appbar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toTopOf="@+id/llSender"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llSender"
        android:background="@color/backgroundItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <EditText
            android:textSize="13sp"
            android:textColor="@color/textItem"
            android:layout_gravity="center"
            android:id="@+id/etComment"
            android:background="@null"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:hint="Текст комментария"
            android:maxLines="2"
            android:minLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"/>
        <ImageView
            android:id="@+id/btnSend"
            android:padding="12dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:tint="@color/textItem"
            app:srcCompat="@drawable/ic_send"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
