<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivPreview"
            android:background="@color/blue"
            android:layout_width="140dp"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tvDescriptionType,tvDescriptionProducer,tvDescriptionGenre,tvDescriptionRelease"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescriptionRelease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Вышел:"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvRelease"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="2017"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintStart_toStartOf="@+id/barrier"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescriptionGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Жанр:"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintTop_toBottomOf="@+id/tvRelease"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvGenre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="комедия, фэнтези"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintStart_toStartOf="@+id/barrier"
            app:layout_constraintTop_toBottomOf="@+id/tvRelease"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescriptionType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Тип:"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintTop_toBottomOf="@+id/tvGenre"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="ТВ (26 эп.), 25 мин."
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintStart_toStartOf="@+id/barrier"
            app:layout_constraintTop_toBottomOf="@+id/tvGenre"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescriptionProducer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Режиссёр:"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintTop_toBottomOf="@+id/tvType"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvProducer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Ёнэда Кадзухиро"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintStart_toStartOf="@+id/barrier"
            app:layout_constraintTop_toBottomOf="@+id/tvType"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescriptionRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Рейтинг:"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintTop_toBottomOf="@+id/tvProducer"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="9.2"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPreview"
            app:layout_constraintStart_toStartOf="@+id/barrier"
            app:layout_constraintTop_toBottomOf="@+id/tvProducer"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ivPreview, tvRating, tvDescriptionRating"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/textItem"
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="ASASDASDASDASDASDASD"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            app:layout_constraintTop_toBottomOf="@+id/barrier1"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            app:cardBackgroundColor="#373b3f"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescription">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/textItem"
                    android:id="@+id/tvAnimeList"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Это аниме состоит из:"
                    android:paddingStart="5dp"
                    android:paddingEnd="7dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAnimeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tvAnimeList"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
