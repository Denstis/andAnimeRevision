<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/bgInfoItemListAnime">
    <RelativeLayout
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_description_anime"
            android:gravity="center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Жанры:"
            android:layout_alignTop="@+id/btnClose"
            android:layout_alignBottom="@+id/btnClose"
            android:layout_marginStart="5dp"/>
        <ImageView
            android:id="@+id/btnClose"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="TODO"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_close"/>
        <View
            android:background="@color/background"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/btnClose"/>
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:layout_below="@+id/btnClose"
            app:srcCompat="@mipmap/kyk"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:background="@color/common_google_signin_btn_text_dark_disabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_below="@+id/ivImage"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="1dp"
            android:layout_alignEnd="@+id/ivImage"
            android:layout_alignParentStart="true"
            app:layout_constraintStart_toStartOf="parent"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
